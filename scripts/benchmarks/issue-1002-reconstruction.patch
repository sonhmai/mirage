@@ -0,0 +1,8 @@
+export function eventLoopYielder() {
+  let last = performance.now()
+  return async () => {
+    if (performance.now() - last < 20) return
+    await new Promise<void>(r => typeof setImmediate === 'function' ? setImmediate(r) : setTimeout(r, 0))
+    last = performance.now()
+  }
+}
